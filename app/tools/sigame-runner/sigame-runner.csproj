<Project Sdk="Microsoft.NET.Sdk">
  <!-- Стенд «Прогон в SIGame»: настоящий движок SIGame (SIPackages, SIEngine, SICore) из исходников
       закреплённого коммита (versions.json, npm run sigame-src). Своих копий кода движка здесь нет. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SIRoot Condition="'$(SIRoot)' == ''">$(MSBuildThisFileDirectory)../../.sigame-src/SI</SIRoot>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="$(SIRoot)/src/SICore/SICore/SICore.csproj" />
  </ItemGroup>
</Project>
